    "package": "npm run build && node dist/package.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0"
  },
  "devDependencies": {
    "@types/node": "26.00.0",
    "typescript": "7.0.2"
  }
}
